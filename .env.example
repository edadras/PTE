APP_NAME="PTE Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — MySQL 8 in production, SQLite for the test suite.
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pte
# DB_USERNAME=pte
# DB_PASSWORD=pte

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------------------------------------------------------------------
# Redis — two logical instances. The queue connection MUST run with
# maxmemory-policy noeviction; losing a queued job loses a student's answer.
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_HOST=127.0.0.1
REDIS_QUEUE_PORT=6380

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@pte-platform.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Object storage — S3 or Cloudflare R2. Buckets are private; everything is
# served through short-lived pre-signed URLs.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=pte-platform
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------
PTE_PLATFORM_NAME="PTE Platform"
PTE_ROOT_DOMAIN=pte-platform.test
PTE_WEBHOOK_BASE_URL="${APP_URL}"
PTE_SUPPORT_EMAIL=support@pte-platform.test

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
TELEGRAM_API_BASE_URL=https://api.telegram.org

# ---------------------------------------------------------------------------
# Media processing
# ---------------------------------------------------------------------------
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# ---------------------------------------------------------------------------
# AI providers — platform-level keys. Academies on Professional and above may
# supply their own (BYOK), which overrides these per tenant.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
WHISPER_API_KEY=
GOOGLE_STT_API_KEY=

# ---------------------------------------------------------------------------
# Payment gateways
# ---------------------------------------------------------------------------
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
IDPAY_API_KEY=
IDPAY_SANDBOX=true
ZIBAL_MERCHANT=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"
